{
  "schemaVersion": 1,
  "id": "vyorkin.vk-music",
  "name": "VK Music",
  "version": "0.1.0",
  "author": "vyorkin",
  "license": "MIT",
  "description": "VK Music in the Omarchy bar: VKontakte audio with a queue, playlists, radio, search and likes, driven over MPRIS and the media keys.",
  "keywords": [
    "vk",
    "vkontakte",
    "music",
    "audio",
    "player",
    "mpv",
    "mpris",
    "widget"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "VK Music",
    "description": "Play VK Music without keeping a browser open",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "homepage": "https://github.com/vyorkin/omarchy-vk-music",
  "repository": "https://github.com/vyorkin/omarchy-vk-music"
}
