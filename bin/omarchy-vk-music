#!/bin/sh
# Command-line client for the local VK Music service.
#
# This is a POSIX shell script on purpose. The widget runs these commands while
# the user drags a slider, and starting Python cost about 15 ms per command
# against about 0.4 ms for `nc -U` on a Unix socket; at 20 volume steps per
# second that difference is the responsiveness.
#
# The Python client next to this file stays as the fallback: it handles the
# commands this script does not build (the interactive password login) and does
# the same job when neither `nc` nor `socat` is installed.
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-vk-music.sock"
python_client="$self_dir/omarchy-vk-music.py"

transport=""
if command -v nc >/dev/null 2>&1; then
  transport="nc"
elif command -v socat >/dev/null 2>&1; then
  transport="socat"
fi

fallback_to_python() {
  [ -x "$python_client" ] || python_client="$self_dir/omarchy-vk-music"
  exec python3 "$python_client" "$@"
}

backend_down() {
  printf '%s\n' '{"ok": false, "error": {"code": "backend_down", "message": "Сервис VK Music не запущен: systemctl --user start omarchy-vk-music"}}'
  exit 1
}

send() {
  [ -S "$sock" ] || backend_down
  case "$transport" in
    nc) printf '%s\n' "$1" | nc -U "$sock" ;;
    socat) printf '%s\n' "$1" | socat - "UNIX-CONNECT:$sock" ;;
    *) fallback_to_python "$@" ;;
  esac
}

# Small constants so the command table below stays readable.
C_STATUS='{"command":"status"}'
C_SESSION='{"command":"session"}'
C_QUEUE='{"command":"queue"}'
C_SECTIONS='{"command":"sections"}'
C_HOME='{"command":"home"}'
C_NEXT='{"command":"next"}'
C_PREVIOUS='{"command":"previous"}'
C_PAUSE='{"command":"pause"}'
C_STOP='{"command":"stop"}'
C_LOGOUT='{"command":"logout"}'

number() {
  case "$1" in
    ''|*[!0-9-]*) printf 'нужно число, получено: %s\n' "$1" >&2; exit 2 ;;
  esac
  printf '%s' "$1"
}

command_name="${1:-status}"
[ $# -gt 0 ] && shift

case "$command_name" in
  status) send "$C_STATUS" ;;
  session) send "$C_SESSION" ;;
  queue)
    action="${1:-}"
    case "$action" in
      remove) send "$(jq -nc --argjson index "$(number "${2:-0}")" '{command:"queue_remove", index:$index}')" ;;
      clear) send '{"command":"queue_clear"}' ;;
      *) send "$C_QUEUE" ;;
    esac
    ;;
  sections) send "$C_SECTIONS" ;;
  home) send "$C_HOME" ;;
  next) send "$C_NEXT" ;;
  previous) send "$C_PREVIOUS" ;;
  pause|toggle) send "$C_PAUSE" ;;
  stop) send "$C_STOP" ;;
  logout) send "$C_LOGOUT" ;;
  radio) send '{"command":"radio"}' ;;
  suggestions)
    send "$(jq -nc --arg query "$*" '{command:"suggestions", query:$query}')"
    ;;
  search)
    send "$(jq -nc --arg query "$*" '{command:"search", query:$query}')"
    ;;
  section)
    id="${1:-all}"
    if [ $# -gt 1 ]; then
      send "$(jq -nc --arg id "$id" --arg startFrom "$2" '{command:"section", id:$id, startFrom:$startFrom}')"
    else
      send "$(jq -nc --arg id "$id" '{command:"section", id:$id}')"
    fi
    ;;
  jump)
    send "$(jq -nc --argjson index "$(number "${1:-0}")" '{command:"jump", index:$index}')"
    ;;
  seek)
    send "$(jq -nc --argjson value "$(number "${1:-0}")" '{command:"seek", value:$value}')"
    ;;
  volume)
    value="${1:-}"
    live=false
    shift || true
    for flag in "$@"; do
      [ "$flag" = "--live" ] && live=true
    done
    case "$value" in
      +*|-*)
        send "$(jq -nc --argjson delta "$(number "$value")" --argjson live "$live" '{command:"volume", delta:$delta, live:$live}')"
        ;;
      *)
        send "$(jq -nc --argjson value "$(number "$value")" --argjson live "$live" '{command:"volume", value:$value, live:$live}')"
        ;;
    esac
    ;;
  shuffle)
    case "${1:-toggle}" in
      on|true|1|yes) send '{"command":"shuffle","enabled":true}' ;;
      off|false|0|no) send '{"command":"shuffle","enabled":false}' ;;
      *) send '{"command":"shuffle"}' ;;
    esac
    ;;
  repeat)
    send "$(jq -nc --arg mode "${1:-off}" '{command:"repeat", mode:$mode}')"
    ;;
  like|unlike)
    liked=false
    [ "$command_name" = like ] && liked=true
    send "$(jq -nc --arg key "${1:-}" --argjson liked "$liked" \
      '{command:"like", key:$key, liked:$liked}')"
    ;;
  lyrics)
    send "$(jq -nc --arg key "${1:-}" '{command:"lyrics", key:$key}')"
    ;;
  cache)
    send "$(jq -nc --arg action "${1:-stats}" '{command:"cache", action:$action}')"
    ;;
  play)
    target="${1:-}"
    if [ -z "$target" ]; then
      # A bare `play` is the transport toggle, which is what the old alias in the
      # command table meant — and what made every `play section|search|keys`
      # unreachable, because that alias matched first.
      send "$C_PAUSE"
      exit 0
    fi
    [ $# -gt 0 ] && shift
    case "$target" in
      section)
        id="${1:-all}"
        index=0
        title=""
        [ $# -gt 0 ] && shift
        while [ $# -gt 0 ]; do
          case "$1" in
            --title) shift; title="${1:-}" ;;
            *[!0-9]*) ;;
            *) index="$1" ;;
          esac
          shift
        done
        send "$(jq -nc --arg id "$id" --argjson index "$index" --arg title "$title" \
          '{command:"play_section", id:$id, index:$index, title:$title}')"
        ;;
      search)
        index=""
        query=""
        for word in "$@"; do
          case "$word" in
            *[!0-9]*) query="$query $word" ;;
            *) index="$word" ;;
          esac
        done
        query="${query# }"
        if [ -n "$index" ]; then
          send "$(jq -nc --arg query "$query" --argjson index "$index" '{command:"play_search", query:$query, index:$index}')"
        else
          send "$(jq -nc --arg query "$query" '{command:"play_search", query:$query}')"
        fi
        ;;
      playlist)
        owner="$(number "${1:-0}")"
        playlist="$(number "${2:-0}")"
        access_key="${3:-}"
        title="${4:-}"
        send "$(jq -nc --argjson ownerId "$owner" --argjson playlistId "$playlist" \
          --arg accessKey "$access_key" --arg title "$title" \
          '{command:"play_playlist", ownerId:$ownerId, playlistId:$playlistId, accessKey:$accessKey, title:$title}')"
        ;;
      radio)
        send "$(jq -nc --argjson id "$(number "${1:-0}")" '{command:"play_radio", id:$id}')"
        ;;
      queue)
        # Reads a JSON array of tracks from stdin.
        tracks=$(cat)
        send "$(printf '%s' "$tracks" | jq -c '{command:"play_tracks", tracks:.}')"
        ;;
      keys)
        # Queue exactly these tracks, by their VK keys, without a second search.
        title=""
        index=0
        keys=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --title) shift; title="${1:-}" ;;
            --index) shift; index="$(number "${1:-0}")" ;;
            *) keys="$keys $1" ;;
          esac
          [ $# -gt 0 ] && shift
        done
        keys="${keys# }"
        if [ -z "$keys" ]; then
          printf 'использование: play keys <ключ> [<ключ>...] [--title <название>]\n' >&2
          exit 2
        fi
        keys_json="$(printf '%s' "$keys" | tr ' ' '\n' | jq -R . | jq -sc .)"
        send "$(jq -nc --argjson keys "$keys_json" --argjson index "$index" --arg title "$title" \
          '{command:"play_keys", keys:$keys, index:$index, title:$title}')"
        ;;
      *)
        printf 'неизвестный источник: %s\n' "${target:-нет}" >&2
        exit 2
        ;;
    esac
    ;;
  auth)
    action="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$action" in
      web)
        cookies=""
        from_browser=true
        while [ $# -gt 0 ]; do
          case "$1" in
            --cookies) shift; cookies="${1:-}"; from_browser=false ;;
            --no-browser) from_browser=false ;;
          esac
          shift
        done
        if [ -z "$cookies" ] && [ "$from_browser" = false ]; then
          read -r cookies || true
        fi
        if [ -n "$cookies" ]; then
          send "$(jq -nc --arg cookies "$cookies" '{command:"auth_web", cookies:$cookies, fromBrowser:false}')"
        else
          send '{"command":"auth_web","fromBrowser":true}'
        fi
        ;;
      status)
        send "$C_SESSION"
        ;;
      *)
        # The password path prompts for a password, which belongs in the Python
        # client: it reads it with getpass and never puts it in argv.
        fallback_to_python auth "$action" "$@"
        ;;
    esac
    ;;
  prefs)
    settings="{}"
    for pair in "$@"; do
      key="${pair%%=*}"
      value="${pair#*=}"
      [ "$key" = "$pair" ] && continue
      settings=$(printf '%s' "$settings" | jq -c --arg key "$key" --arg value "$value" \
        '.[$key] = (if ($value|test("^(true|false)$")) then ($value == "true")
                    elif ($value|test("^-?[0-9]+$")) then ($value|tonumber)
                    else $value end)')
    done
    send "$(jq -nc --argjson set "$settings" '{command:"preferences", set:$set}')"
    ;;
  *)
    printf 'неизвестная команда: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
